# Скопируйте этот файл в .env и впишите свои значения.
#   Windows (PowerShell/cmd):  copy .env.example .env
#   macOS / Linux:             cp .env.example .env
# Файл .env никому не показывайте и не выкладывайте в git — он уже в .gitignore.

# ── Обязательные ───────────────────────────────────────────────
# Токен бота от @BotFather, выглядит как 123456789:AAH...
TELEGRAM_BOT_TOKEN=
# Куда присылать заявки: id чата. Личный чат — положительное число,
# группа — отрицательное (например -1001234567890). Как узнать — в README.md.
TELEGRAM_CHAT_ID=

# ── Необязательные (раскомментируйте, если нужно) ──────────────
# Порт сервера (хостинги обычно задают его сами).
# PORT=3000

# Если сервер стоит за прокси/хостингом (Render, Railway, nginx) — сколько прокси перед ним, обычно 1.
# Без этого в заявке будет IP прокси, а лимит «одна заявка в 30 секунд» не будет различать посетителей.
# Локально не задавайте.
# TRUST_PROXY=1

# Если страницу сайта открывают с ДРУГОГО адреса/порта, чем этот сервер (CORS) —
# перечислите эти адреса через запятую, без слэша в конце.
# ALLOWED_ORIGINS=http://localhost:5500,https://invite.example.com

# Не чаще одной заявки с одного IP за столько секунд (0 — без ограничения).
# LEAD_COOLDOWN_SECONDS=30
